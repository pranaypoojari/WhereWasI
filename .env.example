# Optional: Google Gemini API Key for on-demand AI zero-spoiler timeline generation for ANY show/movie/anime.
# If left blank, WhereWasI automatically uses its built-in knowledge generator!
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: MongoDB Atlas Connection URI
